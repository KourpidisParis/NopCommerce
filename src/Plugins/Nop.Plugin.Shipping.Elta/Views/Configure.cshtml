@model EltaShippingModel

@using Nop.Plugin.Shipping.Elta.Models
@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="EltaShipping" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                @* Title (per language) *@
                @(await Html.LocalizedEditorAsync<EltaShippingModel, EltaShippingModel.EltaShippingLocalizedModel>("elta-settings-localized",
                @<div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="@Model.Locales[item].Title" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.Locales[item].Title" />
                            <span asp-validation-for="@Model.Locales[item].Title"></span>
                        </div>
                    </div>
                    <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
                </div>
                ,
                @<div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Title" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Title" />
                            <span asp-validation-for="Title"></span>
                        </div>
                    </div>
                </div>
                ))

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Status" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Status" />
                        <span asp-validation-for="Status"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Cost" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Cost" />
                        <span asp-validation-for="Cost"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
